{
  "name": "azulab",
  "version": "0.2.0",
  "description": "Small portfolio service deployed to Azure Container Apps via Terraform and GitHub Actions CI/CD.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "lint": "for f in src/*.js src/routes/*.js; do node -c \"$f\" || exit 1; done",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/storage-blob": "^12.25.0",
    "express": "^4.21.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "tailwindcss": "^4.3.4"
  }
}
